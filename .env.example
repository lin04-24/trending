# 复制为 .env 并填入真实值：cp .env.example .env
# 注意：.env 已被 .gitignore 忽略，切勿提交真实密钥。

# ===== PostgreSQL =====
PostgreSQL_IDRESS=127.0.0.1
PostgreSQL_PORTS=5432
PostgreSQL_NAME=trending
PostgreSQL_KEY=改成你的数据库密码
# 可选，默认 trending
DB_NAME=trending

# ===== QQ 邮箱 SMTP =====
# SEND_MAIL：QQ 发件邮箱；SEND_KEY：QQ 邮箱设置-账户中生成的 SMTP 授权码（非登录密码）
SEND_MAIL=you@qq.com
SEND_KEY=改成你的SMTP授权码
# 收件邮箱，多个用英文逗号分隔
ACCEPT_MAIL=to1@qq.com,to2@qq.com
# 端口固定 465（SSL）
SEND_PORT=465

# ===== GitHub =====
# GitHub PAT（读 public 仓库 README 用，classic token 不勾选任何权限即可，仅用于提升 API 速率限制）
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# ===== LLM（OpenAI 兼容接口）=====
LLM_BASE_URL=https://api.example.com/v1
LLM_MODEL=your-model-name
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
